# MongoDB Atlas connection string (Get for free at https://www.mongodb.com/cloud/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/spendwise?retryWrites=true&w=majority

# JWT secret key for signing authentication tokens
JWT_SECRET=spendwise_production_secure_secret_key_change_this

# Port (Optional: Render/Heroku/Railway assigns this automatically)
PORT=5001

# Environment mode
NODE_ENV=production
