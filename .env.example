# -------------------------------------------------------------
# SpendWise Environment Configuration
# -------------------------------------------------------------

# MongoDB Connection String
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/expense_tracker

# Cloud MongoDB (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/expense_tracker?retryWrites=true&w=majority

# Server Port
PORT=5001

# JWT Secret for User Authentication (Change this to a random 64-char string in production)
JWT_SECRET=spendwise_secure_jwt_key_classic_financial_ledger_2025

# Environment (development or production)
NODE_ENV=production

# Frontend API URL Override (Optional - only needed if frontend is hosted on a different domain than backend)
# VITE_API_URL=https://your-backend-service.onrender.com/api/expenses
